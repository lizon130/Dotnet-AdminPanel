@{
    ViewData["Title"] = "Test Save";
}

<h2>Test Database Save</h2>

<form method="post" action="/Profile/TestSimpleSave">
    @Html.AntiForgeryToken()

    <div class="form-group mb-3">
        <label>Phone Number:</label>
        <input type="text" name="testPhone" class="form-control" value="+1234567890" required />
    </div>

    <div class="form-group mb-3">
        <label>Address:</label>
        <input type="text" name="testAddress" class="form-control" value="123 Test Street" required />
    </div>

    <div class="form-group mb-3">
        <label>Designation:</label>
        <input type="text" name="testDesignation" class="form-control" value="Developer" required />
    </div>

    <button type="submit" class="btn btn-primary">Test Save</button>
</form>